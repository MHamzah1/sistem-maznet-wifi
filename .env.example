# Opsional: diperlukan untuk endpoint yang menyimpan data dan cron billing.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Rahasia backend. Jangan memakai prefix VITE_ karena nilai VITE_ masuk ke bundle browser.
XENDIT_WEBHOOK_TOKEN=ganti-dengan-callback-token-xendit
XENDIT_SECRET_KEY=ganti-dengan-secret-key-xendit
CRON_SECRET=ganti-dengan-random-string-minimal-16-karakter
BILLING_API_SECRET=ganti-dengan-random-string-minimal-16-karakter
